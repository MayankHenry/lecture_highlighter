# Cloudinary (https://console.cloudinary.com -> Dashboard)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Any OpenAI-compatible LLM (OpenAI, Groq, Gemini OpenAI-compat, Together...)
# Leave LLM_API_KEY empty to run with a simple fallback chaptering (no AI titles).
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# tiny | base | small  (use tiny/base on CPU)
WHISPER_MODEL=base
